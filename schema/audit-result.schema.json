{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "file_name", "file_path", "file_hash", "created_at", "finding_count", "findings", "coverage", "warnings"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "file_name": {"type": "string"},
    "file_path": {"type": "string"},
    "file_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string"},
    "finding_count": {"type": "integer", "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["detector_id", "severity", "evidence_strength", "false_positive_risk", "confidence", "review_priority_score", "sheet_name", "ranges", "column_names", "phenomenon", "statistical_basis", "assumptions", "plausible_benign_causes", "recommended_review", "raw_evidence"],
        "properties": {
          "detector_id": {"type": "string"},
          "severity": {"enum": ["high", "medium", "low", "info"]},
          "evidence_strength": {"type": "string"},
          "false_positive_risk": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "review_priority_score": {"type": "number", "minimum": 0, "maximum": 100},
          "sheet_name": {"type": "string"},
          "ranges": {"type": "array", "items": {"type": "string"}},
          "column_names": {"type": "array", "items": {"type": "string"}},
          "phenomenon": {"type": "string"},
          "statistical_basis": {"type": "string"},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "plausible_benign_causes": {"type": "array", "items": {"type": "string"}},
          "recommended_review": {"type": "string"},
          "raw_evidence": {"type": "object"}
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["detector_id", "status", "reason", "tables", "finding_count"],
        "properties": {
          "detector_id": {"type": "string"},
          "status": {"enum": ["completed", "partial", "skipped", "disabled"]},
          "reason": {"type": "string"},
          "tables": {"type": "array", "items": {"type": "string"}},
          "finding_count": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
